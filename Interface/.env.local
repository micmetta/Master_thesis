# Configurazione database Bioinformatica (BioInfoDB)
POSTGRES_HOST=db # con Docker si usa il nome servizio (db) invece di localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=bioInfoDB

# Configurazione database sperimentale delle queries (ExperimentalDB)
EXPERIMENTAL_DB_HOST=experimentaldb # con Docker si usa il nome servizio (experimentaldb) invece di localhost
EXPERIMENTAL_DB_PORT=5432 # (c'era 5433 ma con Docker bisogna usare 5432)
EXPERIMENTAL_DB_USER=postgres
EXPERIMENTAL_DB_PASSWORD=root
EXPERIMENTAL_DB_NAME=experimentalDB

# Configurazioni SSH
NEXT_PUBLIC_SSH_USER=mmetta
NEXT_PUBLIC_SSH_SERVER=c3sfr1.di.unito.it
NEXT_PUBLIC_PATH_FILE_INFERENCES=/beegfs/home/mmetta/Test/TestTesi # verrà usato 1) o così: "/beegfs/home/mmetta/Test/TestTesi" (per ottenere il percorso dove verranno salvati i files contenenti le inferenze richieste) 2) oppure così:  "/beegfs/home/mmetta/Test/TestTesi/job_script_${model}.sh" (per ottenere il percorso dello script .sh che dovrà essere eseguito da SLURM (in base al modello scelto dall'utente)) 3) oppure così: "/beegfs/home/mmetta/Test/TestTesi/output_querySQL_${userId}.txt" (per ottenere il percorso del file di output di un utente specifico)
