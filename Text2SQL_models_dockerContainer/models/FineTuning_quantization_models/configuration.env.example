# File path configuration variables:
BASE_PATH= # unique with the initial '/' symbol
PATH_DATASET=
PATH_BASE_MODEL=
PATH_OFFLOAD_BASE_MODEL_DIR=
NAME_NEW_MODEL=
NAME_OFFLOAD_CACHE_DIR_NEW_MODEL=

# LLM hyperparameter setting variables:
WAIT=60

# QLoRA parameters
LORA_R=64
LORA_ALPHA=16
LORA_DROPOUT=0.1

# bitsandbytes parameters
USE_4BIT=True
BNB_4BIT_COMPUTE_DTYPE=float16
BNB_4BIT_QUANT_TYPE=nf4
USE_NESTED_QUANT=False

# TrainingArguments parameters
NUM_TRAIN_EPOCHS=10
FP16=True
BF16=False
PER_DEVICE_TRAIN_BATCH_SIZE=1
PER_DEVICE_EVAL_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=1
GRADIENT_CHECKPOINTING=True
MAX_GRAD_NORM=0.3
LEARNING_RATE=2e-4
WEIGHT_DECAY=0.001
OPTIM=paged_adamw_32bit
LR_SCHEDULER_TYPE=cosine
MAX_STEPS=-1
WARMPUT_RATIO=0.03
GROUP_BY_LENGTH=True
SAVE_STEPS=0
LOGGING_STEPS=25

# SFT parameters
MAX_SEQ_LENGTH=None
PACKING=False
DEVICE_MAP=cuda:0
